{
  "$comment": "MAGIQ Media / Springbrook design tokens, extracted from the 19 mockups + springbrooksoftware.com (2026-08-12). Machine-readable mirror of tokens.css. Brand = Springbrook navy #1D3455 + Manrope. Still ideal from marketing: SVG logos + palette sign-off. Feeds a future Tailwind/Style-Dictionary config.",
  "brand": {
    "source": "springbrooksoftware.com",
    "chrome": {
      "bg": "#1D3455",
      "fg": "#FFFFFF",
      "fgMuted": "rgba(255,255,255,0.65)",
      "line": "rgba(255,255,255,0.18)",
      "fieldBg": "rgba(255,255,255,0.10)",
      "fieldBorder": "rgba(255,255,255,0.22)"
    },
    "accent": {
      "base": "#1D3455",
      "hover": "#16283F",
      "on": "#FFFFFF",
      "text": "#1D3455",
      "bg": "#E9EDF3",
      "border": "#B4C0D2"
    },
    "secondary": {
      "cyan": "#00A0D2",
      "green": "#2DCD7C",
      "teal": "#003B49",
      "red": "#B80105"
    },
    "logos": {
      "note": "PNG only from site — request SVG from marketing",
      "colour": "https://springbrooksoftware.com/wp-content/uploads/2021/01/Springbrook_Logo_2020.png",
      "white": "https://springbrooksoftware.com/wp-content/uploads/2020/07/Springbrook_logo_white_clear.png",
      "favicon": "https://springbrooksoftware.com/wp-content/uploads/2020/09/Springbrook_Favicon_09_23-02.png"
    }
  },
  "surface": { "0": "#F4F2EC", "1": "#FAF9F5", "2": "#FFFFFF" },
  "text": { "primary": "#1A1A18", "secondary": "#5F5E5A", "muted": "#908E86" },
  "border": {
    "default": "rgba(20,20,16,0.12)",
    "strong": "rgba(20,20,16,0.18)",
    "stronger": "rgba(20,20,16,0.30)"
  },
  "status": {
    "success": { "text": "#0F6E56", "bg": "#E1F5EE", "border": "#5DCAA5", "icon": "#1D9E75", "role": "Published" },
    "warning": { "text": "#854F0B", "bg": "#FAEEDA", "border": "#EF9F27", "icon": "#BA7517", "role": "In review / Pending / Conformance" },
    "danger":  { "text": "#A32D2D", "bg": "#FCEBEB", "border": "#F09595", "icon": "#E24B4A", "role": "Failed / Destructive" },
    "info":    { "text": "#185FA5", "bg": "#E6F1FB", "role": "Revising / Informational" },
    "purple":  { "text": "#3C3489", "bg": "#EEEDFE", "fill": "#534AB7", "role": "Admin category / Avatars" }
  },
  "mark": { "bg": "#FAC775", "fg": "#633806" },
  "typography": {
    "fontSans": "'Manrope', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif",
    "fontDisplay": "'Red Hat Display', 'Manrope', sans-serif",
    "fontMono": "'Cascadia Code', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "fontNote": "Manrope is OFL-licensed — free to self-host; no font licence to obtain",
    "size": { "h1": 22, "h2": 18, "h3": 14, "body": 13, "sec": 12, "cap": 11, "micro": 10 },
    "weight": { "regular": 400, "medium": 500 },
    "lineHeight": 1.5
  },
  "space": { "1": 4, "2": 6, "3": 8, "4": 10, "5": 12, "6": 14, "7": 16, "8": 18, "9": 20, "10": 22 },
  "radius": { "sm": 6, "base": 8, "lg": 10, "card": 12, "xl": 14, "pill": 20, "full": 9999 },
  "shadow": {
    "md": "0 1px 2px rgba(20,20,16,.06), 0 4px 12px rgba(20,20,16,.08)",
    "popover": "0 8px 24px rgba(20,20,16,.12), 0 2px 6px rgba(20,20,16,.08)"
  },
  "control": { "heightSm": 30, "height": 34, "heightLg": 42 },
  "layout": { "railWidth": 212, "railCollapsed": 56, "sidebarWidth": 232, "contentMax": 720 }
}
