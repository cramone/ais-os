<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="AzureDevOps" value="https://pkgs.dev.azure.com/MAGIQSoftware/_packaging/MagiqMobile/nuget/v3/index.json" />
<!--		 <add key="AzureDevOps" value="C:\Packages" /> -->
	</packageSources>
	<packageSourceCredentials>
      <AzureDevOps>
        <add key="Username" value="AzureDevOps" />
        <add key="ClearTextPassword" value="" />
      </AzureDevOps>
    </packageSourceCredentials>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="ramonedevelopment.com">
			<package pattern="Magiq.AspNetCore.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>