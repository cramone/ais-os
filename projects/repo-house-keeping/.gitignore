# ── Inventory raw API dumps (CSVs are tracked) ───────────
spec/inventory/**/raw/

# ── Tooling ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.vs/
.idea/

# ── Live dashboard backups ────────────────────────────────
spec/.backups/
