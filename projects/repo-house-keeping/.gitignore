# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pat
*.secret

# ── Archived source (cold storage, never commit) ─────────
archive/**/*.zip
archive/**/*.7z
archive/**/*.rar
archive/**/*.tar
archive/**/*.tar.gz
archive/**/*.tgz
archive/**/*.bundle
archive/**/mirror.git/
archive/**/src/
archive/.trash/
# keep: archive/**/ARCHIVE.md, *.sha256, archive-manifest.txt, .rhk-archive.json

# ── NuGet feed packages (binary, catalog in nuget-feeds/README.md) ─
archive/**/nuget-feeds/**/*.nupkg
archive/**/nuget-feeds/**/*.snupkg
archive/.nupkg-catalog.json

# ── Inventory raw API dumps (CSVs are tracked) ───────────
spec/inventory/**/raw/

# ── Tooling ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.vs/
.idea/

# ── Live dashboard backups ────────────────────────────────
spec/.backups/
