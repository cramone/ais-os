# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pat
*.secret

# ── Archived source (cold storage, never commit) ─────────
archive/**/*.zip
archive/**/*.bundle
archive/**/mirror.git/
archive/**/src/
