# Copy to .env (gitignored) and fill in. Never commit real values.
# The scripts read this file. Values already set in your shell take precedence.
# Optional: keep the real file outside this share and point to it with
#   REPO_HK_ENV_FILE=C:\Users\<you>\.config\repo-house-keeping\.env

# ── infoxpert.visualstudio.com (legacy ADO) ──
# PAT scopes (all read-only): Code, Build, Release, Packaging, Project and Team, Service Connections
ADO_INFOXPERT_ORG_URL=https://infoxpert.visualstudio.com
ADO_INFOXPERT_PAT=

# ── dev.azure.com/MAGIQSoftware (current ADO) ──
ADO_MAGIQSOFTWARE_ORG_URL=https://dev.azure.com/MAGIQSoftware
ADO_MAGIQSOFTWARE_PAT=

# ── GitHub (sources + springbrooksoftware destination) ──
# Fine-grained or classic token; read:org, repo (read) for inventory
GH_TOKEN=
